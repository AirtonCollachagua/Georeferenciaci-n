# Copiar a .env y completar. Ninguno de estos valores se versiona.

# --- Google Cloud (Vertex AI + Document AI) ---
GOOGLE_APPLICATION_CREDENTIALS=credentials/extrac-datos-geosys-production-125424726821.json
GCP_PROJECT=extrac-datos-geosys-production
VERTEX_REGION=global

# --- Agente ---
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
GEOREF_MAX_TURNS=40

# --- Document AI (procesador Enterprise Document OCR) ---
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=

# --- LangSmith (trazabilidad) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=georeferenciacion
# Solo si la cuenta es de la región EU:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# "on" registra miniaturas de las vistas; "off" deja solo metadatos.
GEOREF_TRACE_IMAGES=on

# --- Pistas para el sistema de coordenadas (opcionales) ---
# Zonas UTM candidatas cuando el mapa no dice la zona, p. ej. "17S,18S,19S".
GEOREF_REGION_HINT=
# Datum a asumir cuando la leyenda no lo indica: WGS84, PSAD56, SIRGAS2000, SAD69.
GEOREF_DEFAULT_DATUM=
